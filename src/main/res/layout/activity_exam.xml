<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_secure"
            app:tint="#0052FF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CBT SECURE ENGINE"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Terhubung • Mode Aman Aktif"
                android:textSize="11sp"
                android:textColor="#10B981"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvViolation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pelanggaran: 0"
                android:textColor="#FCA5A5"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvPelanggaran"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Pelanggaran: 0"
                android:textSize="12sp"
                android:textColor="#DC2626"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:visibility="gone"/> </LinearLayout>

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30:00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#DC2626"
            android:background="#FEE2E2"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_gravity="center_vertical" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNavLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvNomorSoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOAL 1 DARI 5"
                android:textColor="#0052FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#EFF6FF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvPertanyaan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apa keunggulan utama implementasi Local Storage pada sistem ujian daring?"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:id="@+id/layoutGambarSoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="16dp">

                <ImageView
                    android:id="@+id/ivSoalGambar"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="fitCenter"
                    android:background="#F1F5F9" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ketuk gambar untuk memperbesar"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    app:drawableTint="#64748B"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutEssay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="16dp">

                <EditText
                    android:id="@+id/etJawabanEssay"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:hint="Ketik jawaban uraian Anda di sini..."
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:background="@drawable/bg_input_field"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnUploadGambarJawaban"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Ambil Foto Jawaban"
                    android:backgroundTint="#0F172A"
                    android:textColor="@color/white"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:cornerRadius="12dp"/>

                <ImageView
                    android:id="@+id/ivPreviewJawaban"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="16dp"
                    android:scaleType="fitCenter"
                    android:background="#FAFAFA"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnHapusGambarJawaban"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hapus Lampiran Foto"
                    android:textColor="#DC2626"
                    android:backgroundTint="#FEE2E2"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconTint="#DC2626"
                    android:visibility="gone"/>
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rgOpsiJawaban"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A. Kecepatan akses internet"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_field"
                    android:buttonTint="#0052FF"
                    android:textColor="#334155" />

                <RadioButton
                    android:id="@+id/rbB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="B. Fault tolerance dan integritas data"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_field"
                    android:buttonTint="#0052FF"
                    android:textColor="#334155" />

                <RadioButton
                    android:id="@+id/rbC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="C. Tampilan UI yang lebih menarik"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_field"
                    android:buttonTint="#0052FF"
                    android:textColor="#334155" />

                <RadioButton
                    android:id="@+id/rbD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="D. Pengurangan biaya server"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_field"
                    android:buttonTint="#0052FF"
                    android:textColor="#334155" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/layoutEssay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etJawabanEssay"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:hint="Ketik jawaban uraian Anda di sini..."
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:background="@drawable/bg_input_field"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnUploadGambarJawaban"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📷 Lampirkan Foto Jawaban"
                    android:backgroundTint="#0F172A"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"/>

                <ImageView
                    android:id="@+id/ivPreviewJawaban"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnHapusGambarJawaban"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hapus Gambar"
                    android:textColor="#DC2626"
                    android:backgroundTint="#FEE2E2"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="76dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="0dp">

        <Button
            android:id="@+id/btnSebelumnya"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:text="Sebelumnya"
            android:textColor="#64748B"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnSelanjutnya"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#0052FF"
            android:text="Selanjutnya"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>