<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_lock_lock"
        app:tint="@color/signature_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="64dp"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buat Sandi Baru"
        android:textColor="@color/slate_900"
        android:textSize="32sp"
        android:fontFamily="@font/calistoga"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/ivIcon" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Keamanan akun sangat penting. Silakan masukkan kata sandi baru yang kuat dan mudah diingat."
        android:textColor="@color/slate_600"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:fontFamily="@font/inter_regular"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <LinearLayout
        android:id="@+id/formSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kata Sandi Baru"
            android:textColor="@color/slate_900"
            android:textSize="14sp"
            android:fontFamily="@font/inter_bold"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Minimal 6 Karakter"
            android:textColorHint="@color/slate_600"
            android:textColor="@color/slate_900"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="20dp"
            android:inputType="textPassword"
            android:fontFamily="@font/inter_regular"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ulangi Kata Sandi Baru"
            android:textColor="@color/slate_900"
            android:textSize="14sp"
            android:fontFamily="@font/inter_bold"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp" />

        <EditText
            android:id="@+id/etConfirmNewPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Masukkan ulang sandi baru"
            android:textColorHint="@color/slate_600"
            android:textColor="@color/slate_900"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="20dp"
            android:inputType="textPassword"
            android:fontFamily="@font/inter_regular" />

    </LinearLayout>
    <Button
        android:id="@+id/btnSavePassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Simpan Kata Sandi"
        android:background="@drawable/btn_primary_gradient"
        app:backgroundTint="@null"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:fontFamily="@font/inter_bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/formSection" />

</androidx.constraintlayout.widget.ConstraintLayout>